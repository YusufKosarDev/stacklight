# Reference only. Real values live in the Render dashboard, never in this repo.
#
# Two edits turn the string Neon shows into the one below: add the "jdbc:"
# prefix, and use the DIRECT host (drop "-pooler"). The channel_binding
# parameter can stay -- pgjdbc has supported it since 42.7.4.
#
# Without the "jdbc:" prefix the application fails at startup with
# IllegalArgumentException: 'url' must start with "jdbc". A stray leading
# space in the value produces exactly the same error.

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-direct-host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=
INGEST_API_KEY=
