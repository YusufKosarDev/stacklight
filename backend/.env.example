# Reference only. Real values live in the Render dashboard, never in this repo.
#
# Use the Neon DIRECT host (no "-pooler"), and drop the channel_binding
# parameter Neon shows -- the JDBC driver does not accept it.

SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-direct-host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=
INGEST_API_KEY=
