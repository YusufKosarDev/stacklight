.render-out/

# --- tooling -------------------------------------------------------------
.vercel
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.DS_Store
Thumbs.db
npm-debug.log*

# Local scratch directories from editor and verification tooling are excluded
# per clone in .git/info/exclude rather than here. Naming them in a tracked file
# would put a tool path in the repository, which the `policy` job rejects.
