# --- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- java / maven --------------------------------------------------------
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class

# --- node / next ---------------------------------------------------------
node_modules/
.next/
out/
build/
!**/src/main/**/build/
next-env.d.ts
*.tsbuildinfo

